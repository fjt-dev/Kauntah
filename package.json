{
  "name": "kauntah",
  "version": "2.0.0",
  "description": "World easiest access counter — Cloudflare Workers and self-hosted editions",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "dev:selfhost": "node --watch src/server.ts",
    "start": "node src/server.ts",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc",
    "test": "node --test --experimental-test-coverage tests/*.test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "hono": "^4.13.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260816.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.0.0",
    "wrangler": "^4.123.0"
  }
}
