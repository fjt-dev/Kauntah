{
  "name": "kauntah",
  "version": "2.0.0",
  "description": "World easiest access counter — Cloudflare Workers edition",
  "private": true,
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "cf-typegen": "wrangler types",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && wrangler deploy --dry-run",
    "security:audit": "npm audit --omit=dev --audit-level=high && npm audit signatures",
    "security:audit:full": "npm audit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "test:integration": "node tests/counter.integration.mjs"
  },
  "dependencies": {
    "hono": "4.13.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260815.1",
    "typescript": "^5.0.0",
    "wrangler": "4.131.0"
  }
}
